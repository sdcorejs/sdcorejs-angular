{
  "name": "sdcorejs-angular-showcase",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build showcase",
    "build:prod": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build showcase --configuration production",
    "test": "ng test showcase --watch=false --browsers=ChromeHeadless --source-map=false",
    "link:library": "node ../scripts/link-showcase-library.mjs",
    "prestart": "npm run link:library",
    "prebuild": "npm run link:library"
  },
