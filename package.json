{
  "name": "sdcorejs-angular-orchestrator",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-multi-version-workspaces.ps1",
    "rollout": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-multi-version-workspaces.ps1",
    "legacy:sync-from-vn-angular": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-from-vn-angular.ps1 -AllowLegacySync",
    "lint:v19": "npm --prefix versions/v19 run lint",
    "lint:v20": "npm --prefix versions/v20 run lint",
    "lint:v21": "npm --prefix versions/v21 run lint",
    "lint:release": "npm run lint:v19 && npm run lint:v20 && npm run lint:v21",
    "lint:phase": "node scripts/lint-phase.mjs",
    "lint:phase:release": "node scripts/lint-phase.mjs --workspace v19 --phase release-touched",
    "check:sync": "node scripts/check-version-sync.mjs",
    "collect-docs": "node scripts/collect-docs.mjs",
    "collect-release-docs": "node scripts/collect-release-docs.mjs",
    "generate:showcase-changelog": "node scripts/generate-showcase-changelog.mjs",
    "generate:showcase-examples": "node scripts/generate-showcase-example-sources.mjs",
    "generate:showcase-route-shells": "node scripts/generate-showcase-route-shells.mjs",
    "generate:showcase": "npm run generate:showcase-changelog && npm run generate:showcase-examples",
    "test:showcase-changelog": "node --test scripts/generate-showcase-changelog.test.mjs",
    "test:showcase-examples": "node --test scripts/generate-showcase-example-sources.test.mjs",
    "test:showcase-branding": "node --test scripts/showcase-branding.test.mjs",
    "test:showcase-route-shells": "node --test scripts/generate-showcase-route-shells.test.mjs",
    "test:collect-docs": "node --test scripts/collect-docs.test.mjs",
    "test:published-page": "node --test scripts/build-published-page.test.mjs",
    "test:check-i18n": "node --test scripts/check-i18n.test.mjs",
    "build:page": "node scripts/build-published-page.mjs",
    "prune:pages": "node scripts/build-published-page.mjs --prune-only",
    "test:showcase-generators": "npm run test:showcase-changelog && npm run test:showcase-examples && npm run test:showcase-route-shells",
    "test:scripts": "npm run test:showcase-generators && npm run test:showcase-branding && npm run test:collect-docs && npm run test:published-page && npm run test:check-i18n",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1"
  }
}
