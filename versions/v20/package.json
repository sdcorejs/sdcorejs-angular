{
    "name":  "sdcorejs-angular",
    "version":  "0.0.0",
    "scripts":  {
                    "ng":  "ng",
                    "start":  "ng build sdcorejs-angular --watch",
                    "preshowcase":  "npm --prefix ../.. run generate:showcase",
                    "showcase":  "ng serve showcase",
                    "build:showcase":  "npm --prefix ../.. run generate:showcase && node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build showcase",
                    "watch":  "ng build sdcorejs-angular --watch",
                    "build":  "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build sdcorejs-angular",
                    "pack":  "cd ./dist/sdcorejs-angular && npm pack",
                    "build-pack":  "npm run build && npm run pack",
                    "publish:beta":  "cd ./dist/sdcorejs-angular && npm publish --access public --tag beta",
                    "publish:latest":  "cd ./dist/sdcorejs-angular && npm publish --access public",
                    "test":  "ng test",
                    "test:ci":  "ng test sdcorejs-angular --watch=false --browsers=ChromeHeadless --code-coverage",
                    "test:showcase":  "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng test showcase --watch=false --browsers=ChromeHeadless --source-map=false",
                    "lint":  "ng lint",
                    "check:i18n-parity":  "tsx scripts/check-i18n-parity.mjs",
                    "check:i18n":  "node scripts/check-i18n.mjs",
                    "generate:pdf-worker":  "node scripts/generate-pdf-worker-inline.mjs",
                    "check:pdf-worker":  "node scripts/generate-pdf-worker-inline.mjs --check"
                },
    "private":  true,
    "dependencies":  {
                         "@angular/animations": "^20.0.0",
                         "@angular/cdk": "^20.0.0",
                         "@angular/common": "^20.0.0",
                         "@angular/compiler": "^20.0.0",
                         "@angular/core": "^20.0.0",
                         "@angular/forms": "^20.0.0",
                         "@angular/material": "^20.0.0",
                         "@angular/material-date-fns-adapter": "^20.0.0",
                         "@angular/platform-browser": "^20.0.0",
                         "@angular/platform-browser-dynamic": "^20.0.0",
                         "@angular/router": "^20.0.0",
                         "@bjorn3/browser_wasi_shim":  "^0.4.2",
                         "@ckeditor/ckeditor5-angular":  "11.1.2",
                         "@lucide/angular":  "^1.22.0",
                         "@sdcorejs/angular-material-datetime":  "1.0.3",
                         "@sdcorejs/utils":  "1.1.4",
                         "chart.js":  "^4.5.1",
                         "ckeditor5":  "48.0.0",
                         "date-fns":  "^3.6.0",
                         "exceljs":  "^4.4.0",
                         "keycloak-js":  "^26.2.3",
                         "pdfjs-dist":  "^4.10.38",
                         "prismjs":  "^1.30.0",
                         "rxjs":  "~7.8.0",
                         "tslib":  "^2.3.0",
                         "zone.js":  "~0.15.0"
                     },
    "devDependencies":  {
                            "@angular-devkit/build-angular": "^20.0.0",
                            "@angular/cli": "^20.0.0",
                            "@angular/compiler-cli": "^20.0.0",
                            "@colbymchenry/codegraph":  "^0.9.4",
                            "@types/jasmine":  "~5.1.0",
                            "@types/jest":  "^30.0.0",
                            "@types/prismjs":  "^1.26.6",
                            "angular-eslint":  "19.2.1",
                            "eslint":  "^9.22.0",
                            "eslint-config-prettier":  "^10.1.2",
                            "eslint-plugin-prettier":  "^5.2.6",
                            "eslint-plugin-unused-imports":  "^4.1.4",
                            "jasmine-core":  "~5.5.0",
                            "karma":  "~6.4.0",
                            "karma-chrome-launcher":  "~3.2.0",
                            "karma-coverage":  "~2.2.0",
                            "karma-jasmine":  "~5.1.0",
                            "karma-jasmine-html-reporter":  "~2.1.0",
                            "ng-packagr": "^20.0.0",
                            "prettier":  "^3.8.1",
                            "prettier-eslint":  "^16.4.1",
                            "tsx":  "^4.22.1",
                            "typescript": "~5.8.3",
                            "typescript-eslint":  "8.26.0"
                        }
}
