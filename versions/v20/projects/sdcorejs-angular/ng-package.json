{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/sdcorejs-angular",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": [
    "@sdcorejs/angular-material-datetime",
    "@sdcorejs/utils",
    "date-fns",
    "exceljs",
    "@bjorn3/browser_wasi_shim",
    "keycloak-js",
    "prismjs",
    "pdfjs-dist",
    "@lucide/angular",
    "@tiptap/core",
    "@tiptap/extension-image",
    "@tiptap/extension-mention",
    "@tiptap/extension-subscript",
    "@tiptap/extension-superscript",
    "@tiptap/extension-table",
    "@tiptap/extension-text-align",
    "@tiptap/extension-text-style",
    "@tiptap/extensions",
    "@tiptap/markdown",
    "@tiptap/pm",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "@floating-ui/dom",
    "parse5"
  ],
  "assets": [
    "assets",
    {
      "glob": "*.html",
      "input": "modules/keycloak/htmls",
      "output": "/modules/keycloak/htmls"
    },
    {
      "glob": "**/*.{ts,html,scss}",
      "input": "modules/pattern/features",
      "ignore": ["**/*.spec.ts"],
      "output": "/modules/pattern/features"
    },
    {
      "glob": "**/*.md",
      "input": "modules/pattern/docs",
      "output": "/modules/pattern/docs"
    },
    {
      "glob": "README.md",
      "input": "modules/pattern",
      "output": "/modules/pattern"
    }
  ]
}
