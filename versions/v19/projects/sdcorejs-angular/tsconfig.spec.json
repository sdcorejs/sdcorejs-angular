/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["jasmine"],
    /*
     * why: the workspace tsconfig maps `@sdcorejs/angular/*` to `./dist/sdcorejs-angular/*` BEFORE
     * `./projects/sdcorejs-angular/*`, so dist wins. Under that mapping the test bundle loaded the
     * last BUILT library for every cross-entry-point import — 59 spec files and 215 source files —
     * which meant a spec could pass against stale code, and editing a shared source file had no
     * effect on the specs of its consumers until someone remembered to run `npm run build` first
     * (see the gotcha recorded in CLAUDE.md "Recent work" #14).
     *
     * Overriding `paths` here points the SPEC build at source only, so `ng test` reflects the
     * working tree. The workspace mapping is left alone because `ng build` legitimately needs dist
     * resolution for already-built secondary entry points.
     */
    "baseUrl": "../../",
    "paths": {
      "@sdcorejs/angular": ["./projects/sdcorejs-angular/src/public-api"],
      "@sdcorejs/angular/*": ["./projects/sdcorejs-angular/*"]
    }
  },
  /*
   * why: `coverage-includes.spec.ts` pulls every source file into the test bundle so coverage is
   * measured over the whole library. `@ngtools/webpack` refuses to build a file that is not part of
   * the TypeScript program, so the sources have to be in `include` too — with only
   * `**\/*.spec.ts` here every non-spec file failed with "missing from the TypeScript compilation".
   * Side benefit: `ng test` now type-checks the sources under the spec `paths` mapping (source, not
   * dist), so a type error in an untested file surfaces here instead of only in `ng build`.
   */
  "include": ["**/*.ts"]
}
