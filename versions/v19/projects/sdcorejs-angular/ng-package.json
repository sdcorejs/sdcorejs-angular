{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/sdcorejs-angular",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": [
    "@sdcorejs/angular-material-datetime",
    "@sdcorejs/utils",
    "@ckeditor/ckeditor5-angular",
    "ckeditor5",
    "date-fns",
    "exceljs",
    "@omer-go/docx-parser-converter-ts",
    "@bjorn3/browser_wasi_shim",
    "keycloak-js",
    "prismjs",
    "chart.js",
    "pdfjs-dist",
    "@lucide/angular"
  ],
  "assets": [
    "assets",
    {
      "glob": "*.html",
      "input": "modules/keycloak/htmls",
      "output": "/modules/keycloak/htmls"
    }
  ]
}
