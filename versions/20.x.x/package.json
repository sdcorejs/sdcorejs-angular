{
    "name":  "sdcorejs-angular",
    "version":  "0.0.0",
    "scripts":  {
                    "ng":  "ng",
                    "start":  "ng serve demo",
                    "watch":  "ng build sdcorejs-angular --watch",
                    "prebuild":  "npm run test:ci",
                    "build":  "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build sdcorejs-angular",
                    "pack":  "cd ./dist/sdcorejs-angular \u0026\u0026 npm pack",
                    "build-pack":  "npm run build \u0026\u0026 npm run pack",
                    "publish:beta":  "cd ./dist/sdcorejs-angular \u0026\u0026 npm publish --access public --tag beta",
                    "test":  "ng test",
                    "test:ci":  "ng test sdcorejs-angular --watch=false --browsers=ChromeHeadless",
                    "lint":  "ng lint",
                    "mv:sync":  "powershell -ExecutionPolicy Bypass -File ./scripts/sync-multi-version-workspaces.ps1"
                },
    "private":  true,
    "dependencies":  {
                         "@angular/animations": "^20.0.0",
                         "@angular/cdk": "^20.0.0",
                         "@angular/common": "^20.0.0",
                         "@angular/compiler": "^20.0.0",
                         "@angular/core": "^20.0.0",
                         "@angular/forms": "^20.0.0",
                         "@angular/material": "^20.0.0",
                         "@angular/material-moment-adapter": "^20.0.0",
                         "@angular/platform-browser": "^20.0.0",
                         "@angular/platform-browser-dynamic": "^20.0.0",
                         "@angular/router": "^20.0.0",
                         "@ckeditor/ckeditor5-angular":  "11.1.2",
                         "@ng-matero/extensions": "^20.0.0",
                         "@ng-matero/extensions-moment-adapter": "^20.0.0",
                         "@omer-go/docx-parser-converter-ts":  "^1.0.0",
                         "ckeditor5":  "48.0.0",
                         "exceljs":  "^4.4.0",
                         "export-to-csv":  "^1.4.0",
                         "keycloak-js":  "^26.2.3",
                         "mammoth":  "^1.11.0",
                         "moment":  "^2.30.1",
                         "prismjs":  "^1.30.0",
                         "rxjs":  "~7.8.0",
                         "tslib":  "^2.3.0",
                         "uuid":  "^11.0.5",
                         "zone.js":  "~0.15.0"
                     },
    "devDependencies":  {
                            "@angular-devkit/build-angular": "^20.0.0",
                            "@angular/cli": "^20.0.0",
                            "@angular/compiler-cli": "^20.0.0",
                            "@types/jasmine":  "~5.1.0",
                            "@types/prismjs":  "^1.26.6",
                            "angular-eslint":  "19.2.1",
                            "eslint":  "^9.22.0",
                            "eslint-config-prettier":  "^10.1.2",
                            "eslint-plugin-prettier":  "^5.2.6",
                            "eslint-plugin-unused-imports":  "^4.1.4",
                            "jasmine-core":  "~5.5.0",
                            "karma":  "~6.4.0",
                            "karma-chrome-launcher":  "~3.2.0",
                            "karma-coverage":  "~2.2.0",
                            "karma-jasmine":  "~5.1.0",
                            "karma-jasmine-html-reporter":  "~2.1.0",
                            "ng-packagr": "^20.0.0",
                            "prettier":  "^3.8.1",
                            "prettier-eslint":  "^16.4.1",
                            "typescript":  "~5.7.2",
                            "typescript-eslint":  "8.26.0"
                        }
}

