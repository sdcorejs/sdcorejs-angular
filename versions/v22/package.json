{
  "name": "sdcorejs-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build sdcorejs-angular --watch",
    "watch": "ng build sdcorejs-angular --watch",
    "build": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build sdcorejs-angular",
    "pack": "cd ./dist/sdcorejs-angular && npm pack",
    "build-pack": "npm run build && npm run pack",
    "publish:beta": "cd ./dist/sdcorejs-angular && npm publish --access public --tag beta",
    "publish:latest": "cd ./dist/sdcorejs-angular && npm publish --access public",
    "test": "node ../../scripts/run-ng-test-no-cache.mjs",
    "test:ci": "node ../../scripts/run-ng-test-no-cache.mjs sdcorejs-angular --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "check:i18n-parity": "tsx scripts/check-i18n-parity.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "generate:pdf-worker": "node scripts/generate-pdf-worker-inline.mjs",
    "check:pdf-worker": "node scripts/generate-pdf-worker-inline.mjs --check"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/animations": "~22.1.4",
    "@angular/cdk": "~22.1.4",
    "@angular/common": "~22.1.4",
    "@angular/compiler": "~22.1.4",
    "@angular/core": "~22.1.4",
    "@angular/forms": "~22.1.4",
    "@angular/material": "~22.1.4",
    "@angular/material-date-fns-adapter": "~22.1.4",
    "@angular/platform-browser": "~22.1.4",
    "@angular/platform-browser-dynamic": "~22.1.4",
    "@angular/router": "~22.1.4",
    "@ckeditor/ckeditor5-angular": "11.1.2",
    "@lucide/angular": "^1.22.0",
    "@sdcorejs/angular-material-datetime": "1.0.4",
    "@sdcorejs/utils": "1.1.4",
    "chart.js": "^4.5.1",
    "ckeditor5": "48.0.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "keycloak-js": "^26.2.3",
    "pdfjs-dist": "^4.10.38",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.6",
    "@angular/cli": "~22.1.6",
    "@angular/compiler-cli": "~22.1.4",
    "@colbymchenry/codegraph": "^0.9.4",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/prismjs": "^1.26.6",
    "angular-eslint": "~22.1.0",
    "axe-core": "4.13.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "~22.1.1",
    "prettier": "3.8.3",
    "prettier-eslint": "^16.4.1",
    "tsx": "^4.22.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
